# Copy to .env.local for development.
#
# Where the frontend sends stats and account requests. Leave it pointing at the
# local API while developing — the default (production) means local test games
# write real rows into the live database.
VITE_STATS_API_BASE_URL=http://localhost:8787

# --- Server-side (set these in your host's environment, not here) ------------
#
# DATA_DIR       Absolute path to a persistent disk mount. Required in
#                production: without it the data lives inside the app checkout,
#                which is rebuilt from git on every deploy and therefore wiped.
#                Example: /var/data
#
# CORS_ORIGINS   Comma-separated list of allowed browser origins.
#                Example: https://www.typedle.net,https://typedle.net
#
# PORT           Port for the API server. Defaults to 8787.
